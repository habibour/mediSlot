# Copy to .env and fill in, or let ./scripts/gen-env.sh generate strong random values.
DB_PASSWORD=
# >= 32 bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Base64 of exactly 32 bytes, e.g. `openssl rand -base64 32`
FIELD_ENCRYPTION_KEY=
# Optional: host port for the API (default 8081)
# APP_PORT=8081
